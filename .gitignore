@"
# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Large dataset files (keep folder structure, ignore raw/processed data)
data/*
!data/.gitkeep
*.jsonl
*.json
*.parquet
*.zip

# Model checkpoints & weights
models/
*.pt
*.bin
*.safetensors

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
"@ | Out-File -FilePath .gitignore -Encoding utf8

